# Copy to .env and change what you need. Every line is optional; these are the defaults.
# No credentials are needed: everything runs on this machine.

# Vision-language model served by Ollama. Must accept images.
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_URL=http://127.0.0.1:11434

# Web server. Keep the host on loopback unless you know why you are changing it.
DRISHTI_HOST=127.0.0.1
DRISHTI_PORT=8000

# Limits
DRISHTI_VLM_TIMEOUT_S=120
DRISHTI_MAX_TOKENS=600
DRISHTI_MAX_IMAGE_BYTES=4194304

# Automatic monitoring (experimental)
DRISHTI_CHANGE_THRESHOLD=12
DRISHTI_MIN_INTERVAL_S=4
DRISHTI_REPEAT_SUPPRESS_S=20

# Speech recognition for voice commands: tiny, base or small. Larger is more accurate and slower.
WHISPER_MODEL=base
WHISPER_THREADS=8

# Piper voices: file names inside voices/, without .onnx
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-pratham-medium
